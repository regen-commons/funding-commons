{
  "name": "@weave/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Weave's server functions. Each handler is deployed through a one-line entry in packages/app/api.",
  "exports": {
    "./health": {
      "types": "./src/health.ts",
      "source": "./src/health.ts",
      "default": "./dist/health.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test src/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "6.0.3"
  }
}
