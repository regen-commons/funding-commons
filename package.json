{
  "name": "funding-commons",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun serve.mjs",
    "test": "node --test tests/*.test.mjs scripts/harness/*.test.mjs scripts/quality/*.test.mjs && bun run --filter '*' test",
    "build": "node scripts/build-ai.mjs && node scripts/check.mjs && bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "prepare:ai": "node scripts/build-ai.mjs",
    "research:collect": "python3 scripts/collect-sources.py",
    "research:import": "python3 scripts/import-data.py",
    "design:tokens": "bun run --filter @regen-commons/design-system tokens",
    "design:check": "bun run --filter @regen-commons/design-system check",
    "design:serve": "SERVE_ROOT=packages/design-system PORT=4173 bun serve.mjs",
    "guidance:check": "node scripts/quality/check-guidance.mjs"
  },
  "packageManager": "bun@1.4.2",
  "dependencies": {
    "@huggingface/transformers": "4.2.0",
    "onnxruntime-web": "1.26.0-dev.20260416-b7804b056c"
  },
  "devDependencies": {
    "esbuild": "0.28.1"
  },
  "overrides": {
    "onnxruntime-web": "1.26.0-dev.20260416-b7804b056c"
  }
}
