{
  "name": "funding-commons",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build-ai.mjs && node scripts/check.mjs",
    "prepare:ai": "node scripts/build-ai.mjs",
    "research:collect": "python3 scripts/collect-sources.py",
    "research:import": "python3 scripts/import-data.py",
    "design:tokens": "node scripts/design/generate-tokens.mjs",
    "design:check": "node scripts/design/generate-tokens.mjs --check && design.md lint DESIGN.md",
    "design:serve": "SERVE_ROOT=design-system PORT=4173 bun serve.mjs"
  },
  "packageManager": "bun@1.4.2",
  "dependencies": {
    "@huggingface/transformers": "4.2.0",
    "onnxruntime-web": "1.26.0-dev.20260416-b7804b056c"
  },
  "devDependencies": {
    "@google/design.md": "0.4.0",
    "esbuild": "0.28.1",
    "yaml": "2.9.1"
  },
  "overrides": {
    "onnxruntime-web": "1.26.0-dev.20260416-b7804b056c"
  }
}
